<style>
	#message {
		resize: none;
	}

	#about {
		max-width: 600px;
		margin: 0 auto;
	}

	fieldset {
		border-color: rgba(255, 255, 255, 0.5);
		border-width: 2px;
		border-style: groove;
		background-color: rgba(255, 255, 255, 0.1);
		box-shadow: 1px 2px 10px rgba(0, 0, 0, 0.16);

		legend {
			top: 42px;
			float: left;
			text-align: center;
			padding: 12px;
			margin-bottom: 12px;
			border-bottom: 2px dashed rgba(255, 255, 255, 0.5);
		}
	}
</style>

<article>
	<section id="about">
		<form class="grid col-auto-1 gap-2 margin-top-12 align-stretch justify-center" id="send_message">
			<fieldset class="flex flow-column gap-4 padding-12">
				<legend>Send me a message</legend>

				<label class="flex flow-column gap-2">
					Name: <input class="input" id="name" type="text" required min="2" max="100" placeholder="Zach" />
				</label>

				<label class="flex flow-column gap-2">
					Email: <input class="input" id="email" type="email" required max="100"
						placeholder="contact@foo.bar" />
				</label>

				<label class="flex flow-column gap-2">
					Message:
					<textarea class="input" type="text" id="message" min="10" max="2000" rows="5"
						placeholder="Type a message here..." required></textarea>
				</label>

				<button class="button button-primary">Send</button>
			</fieldset>
		</form>
	</section>
</article>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		$("#send_message").on("submit", (ev) => {
			ev.preventDefault();

			const name = $("#name").val();
			const email = $("#email").val();
			const message = $("#message").val();
			const notyf = new Notyf({
				position: {
					x: "center",
					y: "top"
				}
			});

			fetch("/send_message", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify({ message, name, email })
			}).then((response) => {
				notyf.success("Message sent.", {
					position: top,
				});
				ev.currentTarget.reset();
			}).catch((e) => {
				notyf.error(`Error: ${e.toString()}`)
			})
		});
	})
</script>